cabal-version:      2.4
name:               haskell-linear-qlearning-pricing
version:            0.1.0.0
synopsis:           Linear Q-Learning in Haskell for dynamic pricing
description:
  An agent that learns, through linear function approximation of the
  Q-value, how to price tickets over time.
license:            MIT
author:             Victor Leme, Adam Stader, Lucas Laus, Guilherme Franco
build-type:         Simple

common shared
    default-language:   Haskell2010
    default-extensions: BangPatterns
    ghc-options:        -Wall

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Types
                      Environment
                      Features
                      Agent
                      Metrics
    build-depends:    base >=4 && <5
                    , random >=1.2

executable linear-q-pricing
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5
                    , random >=1.2
                    , haskell-linear-qlearning-pricing
